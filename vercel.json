{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/blacksburg",
      "destination": "/index.html"
    },
    {
      "source": "/blacksburg/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/blacksburg/fonts/:path*",
      "destination": "/fonts/:path*"
    },
    {
      "source": "/blacksburg/logos/:path*",
      "destination": "/logos/:path*"
    },
    {
      "source": "/blacksburg/heroes/:path*",
      "destination": "/heroes/:path*"
    },
    {
      "source": "/blacksburg/items/:path*",
      "destination": "/items/:path*"
    },
    {
      "source": "/blacksburg/:name.png",
      "destination": "/:name.png"
    },
    {
      "source": "/blacksburg/:name.svg",
      "destination": "/:name.svg"
    },
    {
      "source": "/blacksburg/:name.jpg",
      "destination": "/:name.jpg"
    },
    {
      "source": "/blacksburg/:name.jpeg",
      "destination": "/:name.jpeg"
    },
    {
      "source": "/blacksburg/:name.webp",
      "destination": "/:name.webp"
    },
    {
      "source": "/blacksburg/:name.ico",
      "destination": "/:name.ico"
    },
    {
      "source": "/blacksburg/:name.txt",
      "destination": "/:name.txt"
    },
    {
      "source": "/blacksburg/:name.xml",
      "destination": "/:name.xml"
    },
    {
      "source": "/blacksburg/:name.json",
      "destination": "/:name.json"
    },
    {
      "source": "/blacksburg/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://zgeqnmzuxrvlqliqkkth.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co https://api.stripe.com https://m.stripe.network https://r.stripe.com https://us.i.posthog.com https://us-assets.i.posthog.com; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
